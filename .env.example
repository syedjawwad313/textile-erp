# Database (Neon PostgreSQL — replace with your own connection string from https://neon.tech)
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require&channel_binding=require"

# Redis
REDIS_URL="redis://localhost:6379"

# API Authentication
JWT_SECRET="change-me-to-a-strong-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-to-a-strong-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"
