# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/textile_erp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API Authentication
JWT_SECRET="super-secret-jwt-key-for-development-only"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super-secret-refresh-key-for-development-only"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"
