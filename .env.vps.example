# ==============================================================================
# Contabo VPS Production Environment Configuration
# Panel Database: textileerp (User: textileerp)
# ==============================================================================

# PostgreSQL Connection String
# Replace <DB_PASSWORD> with the password set when creating the database in your panel
DATABASE_URL="postgresql://textileerp:<DB_PASSWORD>@127.0.0.1:5432/textileerp?schema=public"

# Redis (Optional in-memory cache/broker, default localhost)
REDIS_URL="redis://127.0.0.1:6379"

# Security & Authentication Secrets (Generate secure random 32+ character strings)
JWT_SECRET="replace-with-a-secure-random-secret-key-32-chars-minimum"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-32-chars-minimum"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Ports
# PORT is the web frontend port managed by the panel and proxied by Nginx
PORT=3000
# INTERNAL_API_PORT is the internal NestJS API port (proxied automatically by Next.js)
INTERNAL_API_PORT=4001
NODE_ENV="production"

# Production Tenant & Admin Credentials (Automatically seeded on startup)
INIT_TENANT_ID="demo-tenant-1"
INIT_TENANT_NAME="Acme Textiles Corp"
INIT_ADMIN_EMAIL="admin@acmetextiles.com"
INIT_ADMIN_PASSWORD="AdminPassword123!"
